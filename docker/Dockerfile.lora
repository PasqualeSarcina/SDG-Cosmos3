
# syntax=docker/dockerfile:1.7

FROM nvcr.io/nvidia/pytorch:25.11-py3

COPY --from=ghcr.io/astral-sh/uv:0.10.8 /uv /uvx /usr/local/bin/

WORKDIR /workspace

ENV UV_NO_MANAGED_PYTHON=1 \
    UV_PROJECT_ENVIRONMENT=/workspace/.venv \
    UV_LINK_MODE=copy \
    CAUSAL_CONV1D_FORCE_BUILD=TRUE \
    MAX_JOBS=4

COPY pyproject.toml uv.lock .python-version ./

RUN uv venv /workspace/.venv \
    --python python3.12 \
    --system-site-packages

ENV VIRTUAL_ENV=/workspace/.venv
ENV PATH="/workspace/.venv/bin:${PATH}"

RUN --mount=type=cache,target=/root/.cache/uv \
    set -eu; \
    CUDA_PKGS="$(python -c 'import tomllib,re; d=tomllib.load(open("uv.lock","rb")); print(" ".join(p["name"] for p in d["package"] if re.match(r"^nvidia-.*-cu(12|13)$",p["name"])))')"; \
    set --; \
    for pkg in torch torchvision torchaudio triton $CUDA_PKGS; do \
        set -- "$@" --no-install-package "$pkg"; \
    done; \
    uv sync \
        --locked \
        --no-install-project \
        --no-default-groups \
        --group llm-lora \
        --inexact \
        "$@"

CMD ["/bin/bash"]
